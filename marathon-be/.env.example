# ─── Server ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/marathon?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── SMTP (email delivery) ───────────────────────────────────────────
# Leave SMTP_HOST empty to use dev-mode logging (no real emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@example.com

# ─── Branding (update these before production) ───────────────────────
APP_NAME=EventManagementApp           # Display name in emails, meta
COMPANY_NAME=Company Name             # Legal company name
SUPPORT_EMAIL=support@example.com     # Support/contact email
WEBSITE_URL=https://example.com       # Public website URL
LOGO_URL=                              # URL to brand logo image
PRIMARY_COLOR=#2563eb                 # Primary brand color (hex)
SECONDARY_COLOR=#1e40af               # Secondary brand color (hex)
COPYRIGHT_TEXT=© All rights reserved. # Footer copyright line
EMAIL_FOOTER_TEXT=This is an automated message from the application. Please do not reply to this email.

# Social media (used in email footers and future modules)
FACEBOOK_URL=
TWITTER_URL=
INSTAGRAM_URL=

# ─── Registration ────────────────────────────────────────────────────
REGISTRATION_PREFIX=REG               # Prefix for registration numbers

# ─── Localisation ───────────────────────────────────────────────────
LOCALE=en-IN                          # Locale for date/number formatting

# ─── Cloudinary (image storage) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay (payment gateway) ────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Certificate Verification ───────────────────────────────────────
# Must be the PUBLIC URL of the backend API server (not the frontend).
# Used in QR codes printed on certificates so runners can scan and verify online.
# The verify endpoint is: <VERIFICATION_BASE_URL>/api/certificates/verify/:certNumber
# In production, set to your Render backend URL e.g. https://marathon-be.onrender.com
VERIFICATION_BASE_URL=https://marathon-be.onrender.com

# ─── n8n Automation (optional) ──────────────────────────────────────
# Base webhook URL for n8n workflows. Leave empty to disable automation.
# Example: https://your-n8n.example.com/webhook/stridforge
N8N_WEBHOOK_URL=

# ─── Uploads ────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE=5242880          # Max file size in bytes (default: 5MB)

# ─── Zoho CRM (optional — leave blank to disable) ────────────────────
# Required to sync participant registrations to Zoho CRM Contacts.
# 1. Create a Self Client in Zoho API Console
# 2. Generate a refresh_token with scope: ZohoCRM.modules.ALL
# 3. Set the values below
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/crm/v2
