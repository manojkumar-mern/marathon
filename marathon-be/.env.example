PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/marathon?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development

# SMTP (email delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@example.com

# Branding (update these before production)
APP_NAME=EventManagementApp
COMPANY_NAME=Company Name
SUPPORT_EMAIL=support@example.com
WEBSITE_URL=https://example.com
LOGO_URL=
PRIMARY_COLOR=#2563eb
SECONDARY_COLOR=#1e40af
COPYRIGHT_TEXT=© All rights reserved.
FACEBOOK_URL=
TWITTER_URL=
INSTAGRAM_URL=
EMAIL_FOOTER_TEXT=This is an automated message from the application. Please do not reply to this email.

# Registration
REGISTRATION_PREFIX=REG

# Localisation
LOCALE=en-IN
