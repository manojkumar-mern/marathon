# ─── Backend API URL ─────────────────────────────────────────────────
# Required in production. Set this to your Render backend service URL + /api
# e.g. https://marathon-be.onrender.com/api
VITE_API_URL=https://marathon-be.onrender.com/api

# ─── Dev only ────────────────────────────────────────────────────────
# Set to true ONLY to skip the admin login form in local development.
# API calls still return 401 without a valid token — this does NOT bypass auth.
# VITE_DEV_BYPASS_AUTH=false
